{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.claude",
			"!**/*.svg",
			"!src/generated",
			"!**/src/gql",
			"!**/next-env.d.ts",
			"!**/schema.graphql"
		]
	},
	"formatter": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"nursery": "off"
		}
	},
	"overrides": [
		{
			"includes": ["**/src/**"],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "warn"
					}
				}
			}
		}
	]
}
