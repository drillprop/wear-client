{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.claude",
			"!**/*.svg",
			"!src/generated",
			"!**/next-env.d.ts"
		]
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"nursery": "off"
		}
	}
}
