apps/web/src/gql/

# claude code local state
.claude/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

.next

# Locally-uploaded item images (see apps/web/src/app/api/upload/route.ts).
# Keep the directory, ignore its contents.
apps/web/public/uploads/*
!apps/web/public/uploads/.gitkeep

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.temp
