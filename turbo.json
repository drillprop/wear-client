{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "codegen"],
			"outputs": [".next/**", "!.next/cache/**", "build/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build", "codegen"]
		},
		"schema": {
			"outputs": ["schema.graphql"]
		},
		"codegen": {
			"outputs": ["src/gql/**"]
		},
		"@wear/web#codegen": {
			"dependsOn": ["@wear/api#schema"],
			"inputs": [
				"../api/schema.graphql",
				"src/app/**",
				"src/graphql/**",
				"codegen.ts"
			],
			"outputs": ["src/gql/**"]
		},
		"test": {
			"dependsOn": ["codegen"],
			"outputs": ["coverage/**"]
		}
	}
}
