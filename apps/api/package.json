{
	"name": "@wear/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"dev:schema": "tsx watch --clear-screen=false src/schema/emit.ts",
		"start": "node build/index.js",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"schema": "tsx src/schema/emit.ts",
		"db:push": "drizzle-kit push",
		"test": "vitest run --coverage"
	},
	"dependencies": {
		"@pothos/core": "catalog:",
		"@pothos/plugin-drizzle": "catalog:",
		"@pothos/plugin-scope-auth": "catalog:",
		"@pothos/plugin-zod": "catalog:",
		"bcrypt": "catalog:",
		"drizzle-orm": "catalog:",
		"graphql": "catalog:",
		"graphql-yoga": "catalog:",
		"jsonwebtoken": "catalog:",
		"nodemailer": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:",
		"@types/bcrypt": "catalog:",
		"@types/jsonwebtoken": "catalog:",
		"@types/node": "catalog:",
		"@types/nodemailer": "catalog:",
		"@types/pg": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@wear/tsconfig": "workspace:*",
		"drizzle-kit": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
