# Box-local API config (#32). Copy to `.env` and adjust for your machine.
# `pnpm dev` loads this via Node's built-in --env-file.
# Matches the local Postgres in docker-compose.yml (port 55432).
DATABASE_URL=postgres://wear:wear@localhost:55432/wear
PORT=4000
# Signing secret for the httpOnly JWT session cookie (#46). Use any long random
# string locally; production injects a real secret via the environment (#32).
JWT_SECRET=dev-only-change-me
# SMTP transport for the password-reset mailer (#49). Point these at a local
# catcher such as Mailpit/Mailhog (host+port) or a Mailtrap inbox; production
# injects real credentials via the environment. MAIL_PORT defaults to 587 and
# MAIL_FROM to no-reply@wear.test if unset.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASS=dev
MAIL_FROM=no-reply@wear.test
