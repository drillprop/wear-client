# Web app config. Copy to `.env` and adjust for your machine.
# Next loads `.env` automatically. The vars mapped in next.config.js (and any
# NEXT_PUBLIC_*) are inlined into the browser bundle; everything else stays
# server-side only.

# --- App Router stack (#67) — server-side only, never reaches the browser ---

# The same-origin proxy route handler (app/api/graphql/route.ts) and the RSC
# Apollo client forward operations here, server-to-server. The browser only ever
# talks to the relative `/api/graphql` on the web origin, so it never learns the
# API origin. Points straight at the apps/api Yoga server in local dev.
INTERNAL_API_URL=http://localhost:4000/graphql

# Shared secret injected on the server→API hop (#32). The API does not enforce it
# yet; any non-empty value is fine locally.
API_SHARED_SECRET=dev-shared-secret

# --- Item images ---
#
# Staff item images upload to the app's own /api/upload route, which writes them
# to apps/web/public/uploads on local disk (the Cloudinary replacement). No
# config needed; nothing reaches the browser bundle.

# Optional: port for the Next server (defaults to 3000).
# PORT=3000
