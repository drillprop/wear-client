# Web app config. Copy to `.env` and adjust for your machine.
# next.config.js loads this via dotenv, then exposes the vars below to the app.

# GraphQL API endpoint. The Apollo client POSTs operations here, and codegen
# reads the schema from it. Without this set, Apollo silently falls back to
# `/graphql` on the web origin and every request 404s.
#
# Local dev points straight at the apps/api Yoga server. NOTE: that is a
# different origin from the Next dev server (:3000 -> :4000), so the API's
# httpOnly `token` session cookie won't stick cross-site until the same-origin
# proxy (#32) lands — logging in works but the session won't persist yet.
BACKEND_URL=http://localhost:4000/graphql

# Cloudinary image upload (staff item images). Use your own unsigned upload
# preset + endpoint; leave blank if you're not exercising image upload.
CLOUDINARY_PRESET=
CLOUDINARY_UPLOAD_URL=

# Optional: port for the Next server (defaults to 3000).
# PORT=3000
